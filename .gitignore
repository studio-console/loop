# Ignore everything in Documents except studio console files
*

# Track these
!.gitignore
!studio_project/
!studio_project/studio_project.py
!studio_project/studio_data/
!studio_project/studio_data/*.json
!studio_project/CLAUDE.md
!studio_project/CURRENT.md
!studio_project/pytest.ini
!studio_project/studio_console/
!studio_project/studio_console/**
studio_project/studio_console/**/__pycache__/
studio_project/studio_console/**/*.pyc
studio_project/.pytest_cache/
